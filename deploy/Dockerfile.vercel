# Vercel build: fetches the source at a pinned commit, so a deployment only needs this one file.
FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG SRC_SHA=fdaed7ca58718e029f06b64778f08d0282ff96c4
RUN curl -fsSL "https://codeload.github.com/adityavdn/auscultation-ai/tar.gz/$SRC_SHA" | tar xz --strip-components=1 -C /app \
 && pip install --no-cache-dir -r requirements.txt
# Trained models + test samples: release asset of this repo, pinned by SHA-256 (joblib files are pickles).
ARG ASSETS_URL=https://api.github.com/repos/adityavdn/auscultation-ai/releases/assets/748758853
ARG ASSETS_SHA256=a2a1c3ac022ed48fbcb1c470d45e9276bff4287078f1ec88e9793ab0a594ccac
RUN curl -fsSL -H "Accept: application/octet-stream" -o /tmp/assets.tgz "$ASSETS_URL" \
 && echo "$ASSETS_SHA256  /tmp/assets.tgz" | sha256sum -c - \
 && tar xzf /tmp/assets.tgz -C /app && rm /tmp/assets.tgz
ENV MODELS_DIR=/app/models SAMPLES_DIR=/app/samples DB_PATH=/tmp/cases.sqlite NUMBA_CACHE_DIR=/tmp MPLCONFIGDIR=/tmp
EXPOSE 7860
CMD ["sh", "-c", "uvicorn app.main:app_from_env --factory --host 0.0.0.0 --port ${PORT:-7860}"]
